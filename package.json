{
  "name": "dsh-desktop-notifications",
  "version": "1.0.0",
  "description": "Windows desktop toast notifications for DeepSeek Harness (DSH): approval requests, user questions, run completion, errors and sign-in prompts — every toast led by the conversation name.",
  "author": "FANLS05",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FANLS05/dsh-desktop-notifications.git"
  },
  "homepage": "https://github.com/FANLS05/dsh-desktop-notifications#readme",
  "bugs": {
    "url": "https://github.com/FANLS05/dsh-desktop-notifications/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "notification",
    "notifications",
    "desktop-notifications",
    "windows",
    "toast",
    "notify",
    "通知",
    "桌面通知",
    "插件"
  ]
}
